material {
  name: "FxGlow",
  shading_model: lit,
  blending: alpha,
  culling: none,

  parameters: [
    { type: float, name: u_effect, default: 0.0 },
    { type: float, name: u_progress, default: 0.0 },
    { type: float, name: u_time, default: 0.0 },
    { type: float, name: u_seed, default: 0.0 },
    { type: float, name: u_fade, default: 1.0 },
    { type: float, name: u_outline, default: 0.0 },
    { type: float, name: u_brightness, default: 0.55 },
    { type: float, name: u_core_r, default: 0.0 },
    { type: float, name: u_core_g, default: 0.0 },
    { type: float, name: u_core_b, default: 0.0 },
    { type: sampler2d, name: base_color_texture, hint: default_white },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    float eff = material_params.u_effect;
    float time = material_params.u_time;
    vec3 coreCol = vec3(
        material_params.u_core_r,
        material_params.u_core_g,
        material_params.u_core_b);

    vec2 suv = uv;
    float extraA = 1.0;
    vec3 emiss = vec3(0.0);

    vec4 tex = texture(base_color_texture, suv);
    vec3 albedo = SRGBToLinear(tex.rgb) * material_params.u_brightness;
    float alpha = tex.a * extraA;

    // pulse 0..1
    float pulse = 0.5 + 0.5 * sin(time * 15.70796);

    // -- 12: unique glow (weak) -------------------------------------------
    if (eff > 11.5 && eff < 12.5) {
      float tint = 0.15 * pulse;
      albedo = mix(albedo, coreCol, tint);
      emiss += coreCol * 0.08 * pulse;
    }

    // -- 13: rare glow (strong) -------------------------------------------
    if (eff > 12.5 && eff < 13.5) {
      float tint = 0.35 * pulse;
      albedo = mix(albedo, coreCol, tint);
      emiss += coreCol * 0.25 * pulse;

      float own = tex.a;
      float rim = 0.0;
      for (int i = 0; i < 8; i++) {
        float ang = 6.2831853 * float(i) / 8.0;
        vec2 off = vec2(cos(ang), sin(ang)) * (7.0 / 256.0);
        float nb = texture(base_color_texture, uv + off).a;
        if (own > 0.3 && nb < 0.15) rim = 1.0;
      }
      emiss += coreCol * 0.12 * pulse * rim;
    }

    // -- outline ----------------------------------------------------------
    if (material_params.u_outline > 0.5) {
      float own = texture(base_color_texture, uv).a;
      float nb = 0.0;
      for (int i = 0; i < 8; i++) {
        float ang = 6.2831853 * float(i) / 8.0;
        vec2 off = vec2(cos(ang), sin(ang)) * (3.5 / 256.0);
        nb = max(nb, texture(base_color_texture, uv + off).a);
        nb = max(nb, texture(base_color_texture, uv + off * 0.5).a);
      }
      if (own < 0.25 && nb > 0.5) {
        albedo = vec3(0.55, 0.42, 0.05);
        emiss = vec3(1.2, 0.95, 0.15) * 1.4;
        alpha = 1.0;
      }
    }

    material.base_color = vec4(albedo, alpha * material_params.u_fade);
    material.roughness = 1.0;
    material.metallic = 0.0;
    material.emissive = emiss;
    PrepareMaterial(material);
  }
}
